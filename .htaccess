DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonicalize an explicitly requested /index.html to the clean root URL.
# THE_REQUEST prevents an internal DirectoryIndex lookup from looping.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# HTTPS is handled by Webkitty/CDN. Do not redirect HTTPS here.

# Local error document preserves the original HTTP 404 status.
ErrorDocument 404 /404.html

# Donation QR account in IBAN+BIC format required by the Czech SPD standard.
<IfModule mod_env.c>
SetEnv DONATION_ACCOUNT CZ8220100000000223366333+FIOBCZPPXXX
</IfModule>

# Always revalidate pages after automatic deployment.
<IfModule mod_headers.c>
<FilesMatch "\\.(html?|js|css)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>

# Never expose local database credentials.
<FilesMatch "^\\.env">
Require all denied
</FilesMatch>

# Server-only administrator recovery configuration.
<Files "admin-config.php">
Require all denied
</Files>
