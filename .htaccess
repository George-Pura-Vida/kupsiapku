DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonicalize an explicitly requested /index.html to the clean root URL.
# THE_REQUEST prevents an internal DirectoryIndex lookup from looping.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# HTTPS is handled by Webkitty/CDN. Do not redirect HTTPS here.

# Local error document preserves the original HTTP 404 status.
ErrorDocument 404 /404.html

# Donation QR account in IBAN+BIC format required by the Czech SPD standard.
<IfModule mod_env.c>
SetEnv DONATION_ACCOUNT CZ8220100000000223366333+FIOBCZPPXXX
</IfModule>

# HTML and JavaScript must revalidate so cart/header fixes are visible immediately.
# Images and CSS may remain long-lived; CSS uses versioned URLs.
<IfModule mod_headers.c>
<FilesMatch "\.html?$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.js$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
</FilesMatch>
<FilesMatch "\.(css|jpg|jpeg|png|webp|avif|svg|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 0 seconds"
ExpiresByType text/javascript "access plus 0 seconds"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Never expose local database credentials.
<FilesMatch "^\.env">
Require all denied
</FilesMatch>

# Server-only administrator recovery configuration.
<Files "admin-config.php">
Require all denied
</Files>
